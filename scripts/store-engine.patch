+package storeauth
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestProvisioningFailureRetainsOnlyNumericAppleCode(t *testing.T) {
+	response := &http.Response{
+		StatusCode: http.StatusUnauthorized,
+		Body: io.NopCloser(strings.NewReader("<plist version='1.0'><dict><key>Response</key><dict><key>Status</key><dict><key>ec</key><integer>-27677</integer><key>em</key><string>private-reply</string></dict></dict></dict></plist>")),
+	}
+	err := provisioningFailure(response)
+	if got := err.Error(); got != "anisette provisioning returned HTTP 401 (Apple code -27677)" {
+		t.Errorf("unexpected safe diagnostic: %s", got)
+	}
+}
