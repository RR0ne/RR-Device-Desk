+		if err == nil && len(data) <= 8192 {
+			if _, err := plist.Unmarshal(data, &body); err == nil && body.Response.Status.Code != 0 {
+				return fmt.Errorf("anisette provisioning returned HTTP %d (Apple code %d)", response.StatusCode, body.Response.Status.Code)
+			}
+		}
