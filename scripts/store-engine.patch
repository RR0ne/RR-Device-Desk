+package storeauth
+
+import (
+	"errors"
+	"net/http"
+	"time"
+)
+
+// RetryTLSHandshake is for preparation calls only. A TLS handshake timeout
+// occurs before the HTTP request is sent. Never retry a rejected sign-in here.
+func RetryTLSHandshake[T any](send func() (T, error)) (T, error) {
+	const attempts = 3
+	for attempt := 1; ; attempt++ {
+		result, err := send()
+		if attempt == attempts || !tlsHandshakeTimedOut(err) {
+			return result, err
+		}
+		time.Sleep(250 * time.Millisecond)
+	}
+}
+
+func tlsHandshakeTimedOut(err error) bool {
+	for err != nil {
+		if err.Error() == "net/http: TLS handshake timeout" {
+			return true
+		}
+		err = errors.Unwrap(err)
+	}
+	return false
+}
+
+// Retry an explicit temporary outage once when Apple has not supplied its own
+// wait interval. Only provisioning calls without account credentials use this.
+func retryProvisioning(send func() (*http.Response, error)) (*http.Response, error) {
+	response, err := RetryTLSHandshake(send)
+	if err != nil || response.Header.Get("Retry-After") != "" {
+		return response, err
+	}
+
+	switch response.StatusCode {
+	case http.StatusBadGateway, http.StatusServiceUnavailable, http.StatusGatewayTimeout:
+		response.Body.Close()
+		time.Sleep(time.Second)
+		return RetryTLSHandshake(send)
+	default:
+		return response, nil
+	}
+}
