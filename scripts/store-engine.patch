+package storeauth
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestRetryTLSHandshake(t *testing.T) {
+	timeout := errors.New("net/http: TLS handshake timeout")
+	for _, test := range []struct {
+		name string
+		fail error
+		wantCalls int
+	}{
+		{"handshake", fmt.Errorf("transport: %w", timeout), 3},
+		{"invalid certificate", errors.New("certificate verification failed"), 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls := 0
+			_, err := RetryTLSHandshake(func() (int, error) {
+				calls++
+				return 0, test.fail
+			})
+			if calls != test.wantCalls || !errors.Is(err, test.fail) {
+				t.Fatalf("got %d calls and %v; want %d calls and %v", calls, err, test.wantCalls, test.fail)
+			}
+		})
+	}
+}
+
+func TestRetryProvisioning(t *testing.T) {
+	for _, test := range []struct {
+		status int
+		retryAfter string
+		want int
+	}{
+		{http.StatusBadGateway, "", http.StatusOK},
+		{http.StatusServiceUnavailable, "", http.StatusOK},
+		{http.StatusGatewayTimeout, "", http.StatusOK},
+		{http.StatusServiceUnavailable, "60", http.StatusServiceUnavailable},
+		{http.StatusUnauthorized, "", http.StatusUnauthorized},
+	} {
+		t.Run(fmt.Sprintf("HTTP %d Retry-After=%s", test.status, test.retryAfter), func(t *testing.T) {
+			calls := 0
+			response, err := retryProvisioning(func() (*http.Response, error) {
+				calls++
+				response := &http.Response{
+					StatusCode: http.StatusOK,
+					Header: make(http.Header),
+					Body: io.NopCloser(strings.NewReader("test")),
+				}
+				if calls == 1 {
+					response.StatusCode = test.status
+					response.Header.Set("Retry-After", test.retryAfter)
+				}
+				return response, nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer response.Body.Close()
+			if response.StatusCode != test.want {
+				t.Fatalf("got HTTP %d; want HTTP %d", response.StatusCode, test.want)
+			}
+		})
+	}
+}
+
+func TestProvisioningReusesConnection(t *testing.T) {
+	var connections atomic.Int32
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		fmt.Fprint(w, "<plist version='1.0'><dict><key>Response</key><dict/></dict></plist>")
+	}))
+	server.Config.ConnContext = func(ctx context.Context, _ net.Conn) context.Context {
+		connections.Add(1)
+		return ctx
+	}
+	server.Start()
+	defer server.Close()
+	for _, phase := range []string{"start", "finish"} {
+		if _, err := sendMachineProvisioning(context.Background(), server.Client(), server.URL+"/"+phase, make([]byte, 16), map[string]any{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := connections.Load(); got != 1 {
+		t.Fatalf("used %d connections; want one", got)
+	}
+}
