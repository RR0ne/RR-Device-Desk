+func TestRRLogoutAndAccountSwitch(t *testing.T) {
+	for _, switching := range []bool{false, true} {
+		dir := t.TempDir()
+		u, _ := url.Parse("https://example.invalid")
+		old := newCookieJar(dir)
+		old.SetCookies(u, []*http.Cookie{{Name: "marker", Value: "old", Path: "/", Expires: time.Now().Add(time.Hour)}})
+		if err := old.Save(); err != nil {
+			t.Fatal(err)
+		}
+		jar := newCookieJar(dir).(*sessionCookies)
+		if len(jar.Cookies(u)) != 1 {
+			t.Fatal("missing seeded on-disk cookie")
+		}
+		ring := sessionTestRing{deleted: map[string]bool{}}
+		store := appstore.NewAppStore(appstore.Args{CookieJar: jar, Keychain: ring})
+		var err error
+		if switching {
+			err = beginStoreLogin(store, jar)
+		} else {
+			err = store.Revoke()
+		}
+		if err != nil || !ring.deleted["account"] || len(jar.Cookies(u)) != 0 || len(newCookieJar(dir).Cookies(u)) != 0 {
+			t.Fatal("previous session survived", err)
+		}
+		if switching {
+			jar.SetCookies(u, []*http.Cookie{{Name: "marker", Value: "new", Path: "/", Expires: time.Now().Add(time.Hour)}})
+			if err := jar.Save(); err != nil {
+				t.Fatal(err)
+			}
+			if len(newCookieJar(dir).Cookies(u)) != 0 {
+				t.Fatal("incomplete login was persisted")
+			}
+			jar.pending.Store(false)
+			if err := jar.Save(); err != nil {
+				t.Fatal(err)
+			}
+			saved := newCookieJar(dir).Cookies(u)
+			if len(saved) != 1 || saved[0].Value != "new" {
+				t.Fatal("wrong session after login")
+			}
+		}
+	}
+}
+func TestRRCookieCleanupErrorAndLock(t *testing.T) {
+	dir := t.TempDir()
+	shared, err := lockSession(dir, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if exclusive, err := lockSession(dir, true); err == nil {
+		exclusive.Close()
+		t.Fatal("transition raced active command")
+	}
+	shared.Close()
+	lock, err := lockSession(dir, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lock.Close()
+	jar := newCookieJar(dir)
+	f := filepath.Join(dir, CookieJarFileName)
+	if err := os.Mkdir(f, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(f, "occupied"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	store := appstore.NewAppStore(appstore.Args{CookieJar: jar, Keychain: sessionTestRing{deleted: map[string]bool{}}})
+	if err := store.Revoke(); err == nil || errors.Is(err, os.ErrNotExist) {
+		t.Fatal("lost cleanup error", err)
+	}
