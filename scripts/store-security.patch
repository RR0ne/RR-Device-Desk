+// A login keeps intermediate cookies in memory until the store confirms the new account.
+type sessionCookies struct {
+	*cookiejar.Jar
+	path    string
+	pending atomic.Bool
+}
+
+func (j *sessionCookies) Save() error {
+	if j.pending.Load() {
+		return nil
+	}
+	return j.Jar.Save()
+}
+
+func (j *sessionCookies) Clear() error {
+	j.RemoveAll()
+	err := os.Remove(j.path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	return err
+}
+
+// Hold a shared lock for ordinary commands, exclusive across a whole session change.
+// The OS releases this lock even when the GUI cancels a child process.
+func lockSession(directory string, exclusive bool) (*os.File, error) {
+	f, err := os.OpenFile(filepath.Join(directory, ".session-lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	mode := unix.LOCK_SH
+	if exclusive {
+		mode = unix.LOCK_EX
+	}
+	if err := unix.Flock(int(f.Fd()), mode|unix.LOCK_NB); err != nil {
+		f.Close()
+		if errors.Is(err, unix.EWOULDBLOCK) {
+			return nil, fmt.Errorf("store session is busy: %w", err)
+		}
+		return nil, err
+	}
+	return f, nil
+}
